# Copie para .env. Não versione segredos.
PG_URL=postgres://tcc:tcc@localhost:5432/tcc
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Modelo de geração fixado no ADR 003 (docs/decisoes/003-embeddings-e-llm.md)
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Juiz da avaliação das respostas (ADR 007); diferente do gerador
JUDGE_MODEL=qwen3.5:4b

# Assistente da empresa (ADR 012, docs/assistente.md). Conector do Google Drive: cliente OAuth
# "Aplicativo da Web" com retorno em <ASSISTENTE_URL>/api/conectores/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do assistente (padrão: http://127.0.0.1:3100)
ASSISTENTE_URL=
# Chave de 32 bytes em base64 que cifra os tokens dos conectores (padrão: gerada em .assistente/chave)
ASSISTENTE_CHAVE=
